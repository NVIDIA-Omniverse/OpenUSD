# Configuration for the installed pxr package.
# Defines PXR_MAJOR_VERSION, PXR_MINOR_VERSION, PXR_PATCH_VERSION, PXR_VERSION,
# PXR_INCLUDE_DIRS, PXR_LIBRARIES (the selected targets), and PXR_foo_LIBRARY
# (the resolved location of each selected compiled library).
# Static builds also define PXR_STATIC as before.
#
# Components tf/gf select the stable core libraries; tfBoostPython/vtBoostPython
# select the version-specific Boost.Python binding interfaces. No components
# selects the complete package for compatibility with existing consumers.
#
# Downstream linkage: use tf for non-monolithic core libraries, or usd_m for a
# monolithic package; there is no need to explicitly link both. In monolithic
# build trees tf is an object library; the installed tf target is interface-only.
# usd_m is the CMake target name, not a filename: its configured output name,
# prefix, or IMPORTED_LOCATION determines the actual library file.
# Boost.Python modules can link tfBoostPython in either mode; it selects tf or
# usd_m and supplies whole-archive linkage for a static monolith.
# See BUILDING.md, "Choosing a Downstream Link Target", and Tf's binding docs.

get_filename_component(PXR_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
set(PXR_MAJOR_VERSION "@PXR_MAJOR_VERSION@")
set(PXR_MINOR_VERSION "@PXR_MINOR_VERSION@")
set(PXR_PATCH_VERSION "@PXR_PATCH_VERSION@")
set(PXR_VERSION "@PXR_VERSION@")
include(CMakeFindDependencyMacro)

set(_pxr_binding_python TRUE)
set(_pxr_libraries "@PXR_ALL_LIBS@")
set(_pxr_stable_components tf gf)
set(_pxr_binding_components tfBoostPython vtBoostPython)
if(pxr_FIND_COMPONENTS)
    set(_pxr_binding_python FALSE)
    set(_pxr_libraries "")
    foreach(_pxr_component IN LISTS pxr_FIND_COMPONENTS)
        set(pxr_${_pxr_component}_FOUND FALSE)
        if(_pxr_component IN_LIST _pxr_stable_components AND NOT @PXR_BUILD_MONOLITHIC@)
            set(pxr_${_pxr_component}_FOUND TRUE)
        elseif(_pxr_component IN_LIST _pxr_binding_components AND @PXR_ENABLE_PYTHON_SUPPORT@)
            set(pxr_${_pxr_component}_FOUND TRUE)
            set(_pxr_binding_python TRUE)
        endif()
        if(pxr_${_pxr_component}_FOUND)
            list(APPEND _pxr_libraries "${_pxr_component}")
        elseif(pxr_FIND_REQUIRED_${_pxr_component})
            set(pxr_FOUND FALSE)
            set(pxr_NOT_FOUND_MESSAGE
                "Unsupported pxr component '${_pxr_component}'. Core components tf/gf require a non-monolithic build; tfBoostPython/vtBoostPython require Python support.")
            return()
        endif()
    endforeach()
endif()

if(@PXR_ENABLE_PYTHON_SUPPORT@ AND _pxr_libraries)
    if(_pxr_binding_python OR NOT WIN32)
        # Installed bindings and legacy core code require the build's Python
        # minor version. A pre-found incompatible Python cannot bypass this.
        set(_pxr_python_components Development)
        if(WIN32)
            list(APPEND _pxr_python_components Development.SABIModule)
        endif()
        find_dependency(Python3 "@Python3_VERSION_MAJOR@.@Python3_VERSION_MINOR@"
            EXACT COMPONENTS ${_pxr_python_components})
    else()
        # The Limited API floor used by Tf is 3.10. Discover the consumer's
        # stable import library and headers without a versioned Python target.
        find_dependency(Python3 3.10 COMPONENTS Development.SABIModule)
    endif()
endif()

if (NOT DEFINED PXR_FIND_TBB_IN_CONFIG)
    set(PXR_FIND_TBB_IN_CONFIG "@PXR_FIND_TBB_IN_CONFIG@")
endif()
if (PXR_FIND_TBB_IN_CONFIG)
    find_dependency(TBB @TBB_VERSION@ CONFIG)
else()
    add_library(TBB::tbb SHARED IMPORTED)

    macro(_add_property name value)
        if (NOT "${value}" STREQUAL "")
            set_target_properties(TBB::tbb PROPERTIES ${name} "${value}")
        endif()
    endmacro()

    _add_property(INTERFACE_INCLUDE_DIRECTORIES "@tbb_INTERFACE_INCLUDE_DIRECTORIES@")
    _add_property(INTERFACE_COMPILE_DEFINITIONS "@tbb_INTERFACE_COMPILE_DEFINITIONS@")
    _add_property(INTERFACE_LINK_DIRECTORIES "@tbb_INTERFACE_LINK_DIRECTORIES@")
    _add_property(IMPORTED_IMPLIB "@tbb_IMPORTED_IMPLIB@")
    _add_property(IMPORTED_LOCATION "@tbb_IMPORTED_LOCATION@")
endif()

if (NOT DEFINED PXR_FIND_OPENSUBDIV_IN_CONFIG)
    set(PXR_FIND_OPENSUBDIV_IN_CONFIG "@PXR_FIND_OPENSUBDIV_IN_CONFIG@")
endif()
if (PXR_FIND_OPENSUBDIV_IN_CONFIG)
    find_dependency(OpenSubdiv @OpenSubdiv_VERSION@ CONFIG)
endif()

# If MaterialX support was enabled for this USD build, try to find the
# associated import targets by invoking the same FindMaterialX.cmake
# module that was used for that build. This can be overridden by
# specifying a different MaterialX_DIR when running cmake.
if(@PXR_ENABLE_MATERIALX_SUPPORT@)
    if (NOT DEFINED MaterialX_DIR)
        if (NOT [[@MaterialX_DIR@]] STREQUAL "")
            set(MaterialX_DIR [[@MaterialX_DIR@]])
        endif()
    endif()
    find_dependency(MaterialX)
endif()

# Similar to MaterialX above, we are using Imath's cmake package config, so set
# the Imath_DIR accordingly to find the associated import targets which were
# used for this USD build. 
# Note that we only need to do this, when it is determined by Imath is being
# used instead of OpenExr (refer Packages.cmake)
if(@Imath_FOUND@)
    if (NOT DEFINED Imath_DIR)
        if (NOT [[@Imath_DIR@]] STREQUAL "")
            set(Imath_DIR [[@Imath_DIR@]])
        endif()
    endif()
    find_dependency(Imath)
endif()

# If this build is using a custom work implementation, find the package
# providing that implementation.
if(NOT "@PXR_WORK_IMPL_PACKAGE@" STREQUAL "")
    if (NOT DEFINED @PXR_WORK_IMPL_CONFIG_DIR_VAR@)
        if (NOT [[@PXR_WORK_IMPL_CONFIG_DIR@]] STREQUAL "")
            set(@PXR_WORK_IMPL_CONFIG_DIR_VAR@ [[@PXR_WORK_IMPL_CONFIG_DIR@]])
        endif()
    endif()
    find_dependency(@PXR_WORK_IMPL_PACKAGE@)
endif()

include("${PXR_CMAKE_DIR}/cmake/pxrTargets.cmake")
if(NOT pxr_FIND_COMPONENTS AND TARGET usd_m)
    set(_pxr_libraries usd_m)
endif()
set(PXR_LIBRARIES "")
set(PXR_INCLUDE_DIRS "${PXR_CMAKE_DIR}/include")
foreach(lib IN LISTS _pxr_libraries)
    get_target_property(_pxr_type ${lib} TYPE)
    if(NOT _pxr_type STREQUAL "INTERFACE_LIBRARY")
        get_target_property(PXR_${lib}_LIBRARY ${lib} LOCATION)
    endif()
    list(APPEND PXR_LIBRARIES ${lib})
endforeach()
if(NOT @BUILD_SHARED_LIBS@)
    if(WIN32)
        list(APPEND PXR_LIBRARIES Shlwapi.lib Dbghelp.lib)
    endif()
    add_definitions(-DPXR_STATIC)
endif()
