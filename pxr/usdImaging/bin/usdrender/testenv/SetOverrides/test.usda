#usda 1.0
(
    defaultPrim = "World"
    renderSettingsPrimPath = "/Render/Settings"
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Materials"
    {
        def Material "Diffuse"
        {
            token outputs:surface.connect = </World/Materials/Diffuse/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Cube "Back" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        rel material:binding = </World/Materials/Diffuse>
        color3f[] primvars:displayColor = [(0.7, 0.7, 0.7)] (
            interpolation = "constant"
        )
        double3 xformOp:scale = (3, 2, 0.1)
        double3 xformOp:translate = (0, 0, -2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        rel material:binding = </World/Materials/Diffuse>
        color3f[] primvars:displayColor = [(0.75, 0.75, 0.75)] (
            interpolation = "constant"
        )
        double3 xformOp:scale = (3, 0.1, 3)
        double3 xformOp:translate = (0, -2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Left" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        rel material:binding = </World/Materials/Diffuse>
        color3f[] primvars:displayColor = [(0.65, 0.15, 0.1)] (
            interpolation = "constant"
        )
        double3 xformOp:scale = (0.1, 2, 3)
        double3 xformOp:translate = (-3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        rel material:binding = </World/Materials/Diffuse>
        color3f[] primvars:displayColor = [(0.1, 0.2, 0.65)] (
            interpolation = "constant"
        )
        double3 xformOp:scale = (0.1, 2, 3)
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Block" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 2
        rel material:binding = </World/Materials/Diffuse>
        color3f[] primvars:displayColor = [(0.8, 0.65, 0.2)] (
            interpolation = "constant"
        )
        double3 xformOp:scale = (0.8, 0.9, 0.8)
        double3 xformOp:translate = (-0.6, -1, -0.3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.8
        rel material:binding = </World/Materials/Diffuse>
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.35)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (1.1, -1.1, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "Light"
    {
        float inputs:intensity = 30
        float inputs:radius = 0.35
        double3 xformOp:translate = (0, 1.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Camera "Camera"
{
    float focalLength = 45
    float horizontalAperture = 20.955
    float verticalAperture = 15.2908
    double3 xformOp:translate = (0, 0, 8)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Scope "Render"
{
    def RenderSettings "Settings" (
        apiSchemas = ["TyphoonRenderSettingsAPI"]
    )
    {
        rel camera = </Camera>
        rel products = [</Render/Product>]
        uniform int ty:convergedSamplesPerPixel = 8
        uniform int ty:randomNumberSeed = 1
    }

    def RenderProduct "Product"
    {
        token productName = "set.png"
        token productType = "raster"
        int2 resolution = (48, 32)
    }
}
