#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    doc = """glTF PBR parameter parity regression scene.

Row 0:
- iridescence = 0.0
- iridescence = 1.0
- anisotropy_strength = 0.85, anisotropy_rotation = 0.0

Row 1:
- anisotropy_strength = 0.85, anisotropy_rotation = 1.5707963
- clearcoat = 1.0, clearcoat_normal = default normal
- clearcoat = 1.0, clearcoat_normal tilted toward +Y

Volume-related inputs and dispersion remain out of scope for ticket 313.
Occlusion is intentionally ignored.
"""
)

def Xform "World"
{
    def Sphere "IridescenceOff" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.65
        double3 xformOp:translate = (-2.2, 1.1, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/IridescenceOffMat>
    }

    def Sphere "IridescenceOn" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.65
        double3 xformOp:translate = (0, 1.1, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/IridescenceOnMat>
    }

    def Sphere "AnisoRotation0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.65
        double3 xformOp:translate = (2.2, 1.1, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/AnisoRotation0Mat>
    }

    def Sphere "AnisoRotation90" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.65
        double3 xformOp:translate = (-2.2, -1.1, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/AnisoRotation90Mat>
    }

    def Sphere "ClearcoatDefaultNormal" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.65
        double3 xformOp:translate = (0, -1.1, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/ClearcoatDefaultNormalMat>
    }

    def Sphere "ClearcoatTiltedNormal" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.65
        double3 xformOp:translate = (2.2, -1.1, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/ClearcoatTiltedNormalMat>
    }

    def Scope "Materials"
    {
        def Material "IridescenceOffMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/IridescenceOffMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.82, 0.82, 0.84)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.22
                float inputs:specular = 1.0
                color3f inputs:specular_color = (1.0, 1.0, 1.0)
                float inputs:ior = 1.5
                float inputs:transmission = 0.0
                float inputs:iridescence = 0.0
                float inputs:iridescence_ior = 1.45
                float inputs:iridescence_thickness = 260.0
                token outputs:out
            }
        }

        def Material "IridescenceOnMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/IridescenceOnMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.82, 0.82, 0.84)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.22
                float inputs:specular = 1.0
                color3f inputs:specular_color = (1.0, 1.0, 1.0)
                float inputs:ior = 1.5
                float inputs:transmission = 0.0
                float inputs:iridescence = 1.0
                float inputs:iridescence_ior = 1.45
                float inputs:iridescence_thickness = 260.0
                token outputs:out
            }
        }

        def Material "AnisoRotation0Mat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/AnisoRotation0Mat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.95, 0.95, 0.95)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.3
                float inputs:specular = 1.0
                float inputs:anisotropy_strength = 0.85
                float inputs:anisotropy_rotation = 0.0
                vector3 inputs:tangent = (1.0, 0.0, 0.0)
                token outputs:out
            }
        }

        def Material "AnisoRotation90Mat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/AnisoRotation90Mat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.95, 0.95, 0.95)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.3
                float inputs:specular = 1.0
                float inputs:anisotropy_strength = 0.85
                float inputs:anisotropy_rotation = 1.5707963
                vector3 inputs:tangent = (1.0, 0.0, 0.0)
                token outputs:out
            }
        }

        def Material "ClearcoatDefaultNormalMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/ClearcoatDefaultNormalMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.12, 0.28, 0.78)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.35
                float inputs:specular = 0.75
                float inputs:clearcoat = 1.0
                float inputs:clearcoat_roughness = 0.03
                vector3 inputs:tangent = (1.0, 0.0, 0.0)
                token outputs:out
            }
        }

        def Material "ClearcoatTiltedNormalMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/ClearcoatTiltedNormalMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "ND_gltf_pbr_surfaceshader"
                color3f inputs:base_color = (0.12, 0.28, 0.78)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.35
                float inputs:specular = 0.75
                float inputs:clearcoat = 1.0
                float inputs:clearcoat_roughness = 0.03
                vector3 inputs:tangent = (1.0, 0.0, 0.0)
                vector3 inputs:clearcoat_normal = (0.0, 0.70710677, 0.70710677)
                token outputs:out
            }
        }
    }

    def SphereLight "KeyLight"
    {
        float inputs:intensity = 450
        float inputs:radius = 0.5
        double3 xformOp:translate = (3, 4, 4)
        token[] xformOpOrder = ["xformOp:translate"]
    }
}
