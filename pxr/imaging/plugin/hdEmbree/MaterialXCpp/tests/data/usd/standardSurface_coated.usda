#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    doc = "Standard Surface with clear coat enabled — car paint look."
)

def Xform "World"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        rel material:binding = </World/Materials/CoatMat>
    }

    def Scope "Materials"
    {
        def Material "CoatMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/CoatMat/StdSurf.outputs:out>

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color = (0.6, 0.02, 0.02)
                float inputs:specular = 1.0
                float inputs:specular_roughness = 0.4
                float inputs:specular_IOR = 1.5
                float inputs:metalness = 0.0
                float inputs:coat = 1.0
                float inputs:coat_roughness = 0.05
                float inputs:coat_IOR = 1.6
                token outputs:out
            }
        }
    }

    def SphereLight "Light"
    {
        float inputs:intensity = 600
        float inputs:radius = 0.3
        double3 xformOp:translate = (2, 5, 3)
        token[] xformOpOrder = ["xformOp:translate"]
    }
}
