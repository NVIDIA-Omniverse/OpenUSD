def Scope "Materials"
{
    def Material "G18Rec709Mat" (
        prepend apiSchemas = ["MaterialXConfigAPI"]
    )
    {
        string config:mtlx:version = "1.38"
        token outputs:mtlx:surface.connect = </Materials/G18Rec709Mat/Surface.outputs:out>

        def Shader "TexCoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "Image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @../images/marcie_2k_srgb.png@
            float2 inputs:texcoord.connect = </Materials/G18Rec709Mat/TexCoord.outputs:out>
            color3f outputs:out
        }

        def Shader "Transform"
        {
            uniform token info:id = "ND_g18_rec709_to_lin_rec709_color3"
            color3f inputs:in.connect = </Materials/G18Rec709Mat/Image.outputs:out>
            color3f outputs:out
        }

        def Shader "Surface"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0.0
            float inputs:specular = 0.0
            float inputs:emission = 1.0
            color3f inputs:emission_color.connect = </Materials/G18Rec709Mat/Transform.outputs:out>
            token outputs:out
        }
    }

    def Material "G22Rec709Mat" (
        prepend apiSchemas = ["MaterialXConfigAPI"]
