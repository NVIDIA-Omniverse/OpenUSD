#usda 1.0
(
    defaultPrim = "World"
    renderSettingsPrimPath = "/RenderSettings"
    subLayers = [
        @microfacet_ms_smoke.usda@
    ]
    doc = """OpenPBR counterpart of microfacet_ms_smoke.usda.

This layer keeps the original camera, lights, mesh layout, and material
bindings, but overrides the material shaders to
ND_open_pbr_surface_surfaceshader so hdEmbree:useAdobeOpenPBR can switch
between the native and Adobe OpenPBR backends."""
)

over "RenderProduct"
{
    token productName = "microfacet_ms_smoke_openpbr.exr"
}

over "RenderSettings"
{
    token hdEmbree:dielectricLayerThroughputMode = "bsdl"
}

over "World"
{
    over "Materials"
    {
        over "GroundMat"
        {
            over "Shader"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 1.0
                color3f inputs:base_color = (0.18, 0.18, 0.18)
                float inputs:base_diffuse_roughness = 0.5
                float inputs:base_metalness = 0.0
                float inputs:specular_weight = 0.0
                float inputs:specular_roughness = 0.5
                color3f inputs:specular_color = (1.0, 1.0, 1.0)
                float inputs:specular_ior = 1.5
            }
        }

        over "WhiteSpecR005"
        {
            over "Shader"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 0.0
                color3f inputs:base_color = (0.0, 0.0, 0.0)
                float inputs:base_metalness = 0.0
                float inputs:specular_weight = 1.0
                float inputs:specular_roughness = 0.05
                color3f inputs:specular_color = (1.0, 1.0, 1.0)
                float inputs:specular_ior = 1.5
            }
        }

        over "WhiteDiffuseR005"
        {
            over "Shader"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 1.0
