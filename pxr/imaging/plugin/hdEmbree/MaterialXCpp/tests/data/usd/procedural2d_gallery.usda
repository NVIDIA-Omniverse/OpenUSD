#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = """MaterialX procedural2d gallery for hdEmbree.
Contains one plane and one sphere for each implemented procedural2d node:
noise2d, cellnoise2d, worleynoise2d, fractal2d, unifiednoise2d,
ramp, ramp_gradient, ramplr, ramptb, ramp4, splitlr, splittb,
checkerboard, grid, circle, hexagon, cloverleaf, crosshatch, line, flake2d."""
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 38
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 9.5, 26)
        float3 xformOp:rotateXYZ = (-20, 0, 0)
        token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def SphereLight "KeyLight"
    {
        float inputs:intensity = 260
        float inputs:radius = 1.2
        double3 xformOp:translate = (14, 18, 12)
        token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "FillLight"
    {
        float inputs:intensity = 90
        float inputs:radius = 0.8
        double3 xformOp:translate = (-16, 11, 18)
        token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Materials"
    {
        def Material "Noise2dMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/Noise2dMat/StdSurf.outputs:out>

            def Shader "TexCoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "ScaleUV"
            {
                uniform token info:id = "ND_multiply_vector2FA"
                float2 inputs:in1.connect = </World/Materials/Noise2dMat/TexCoord.outputs:out>
                float inputs:in2 = 6.0
                float2 outputs:out
            }

            def Shader "Pattern"
            {
                uniform token info:id = "ND_noise2d_float"
                float inputs:amplitude = 0.5
                float inputs:pivot = 0.5
                float2 inputs:texcoord.connect = </World/Materials/Noise2dMat/ScaleUV.outputs:out>
                float outputs:out
            }

            def Shader "Colorize"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.06, 0.08, 0.12)
                color3f inputs:fg = (0.96, 0.74, 0.25)
                float inputs:mix.connect = </World/Materials/Noise2dMat/Pattern.outputs:out>
                color3f outputs:out
            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color.connect = </World/Materials/Noise2dMat/Colorize.outputs:out>
                float inputs:specular = 0.35
                float inputs:specular_roughness = 0.42
                token outputs:out
            }
        }

