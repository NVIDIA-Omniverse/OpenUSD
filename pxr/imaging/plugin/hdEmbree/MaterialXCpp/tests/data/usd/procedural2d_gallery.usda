            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color.connect = </World/Materials/Cellnoise2dMat/Colorize.outputs:out>
                float inputs:specular = 0.28
                float inputs:specular_roughness = 0.45
                token outputs:out
            }
        }

