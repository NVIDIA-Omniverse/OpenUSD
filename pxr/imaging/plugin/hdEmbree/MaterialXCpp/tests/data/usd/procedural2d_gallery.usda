            def Shader "Pattern"
            {
                uniform token info:id = "ND_ramp_gradient"
                float inputs:x.connect = </World/Materials/RampGradientMat/ExtractU.outputs:out>
                float inputs:interval1 = 0.1
                float inputs:interval2 = 0.9
                color4f inputs:color1 = (0.08, 0.07, 0.13, 1.0)
                color4f inputs:color2 = (0.95, 0.82, 0.22, 1.0)
                int inputs:interpolation = 1
                color4f inputs:prev_color = (0.08, 0.07, 0.13, 1.0)
                int inputs:interval_num = 1
                int inputs:num_intervals = 2
                color4f outputs:out
            }

            def Shader "ToColor3"
            {
                uniform token info:id = "ND_convert_color4_color3"
