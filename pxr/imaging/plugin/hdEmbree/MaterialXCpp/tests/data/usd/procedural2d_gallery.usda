                float inputs:lacunarity = 2.0
                float inputs:diminish = 0.5
                float2 inputs:texcoord.connect = </World/Materials/Fractal2dMat/ScaleUV.outputs:out>
                float outputs:out
            }

            def Shader "Normalize"
            {
                uniform token info:id = "ND_remap_float"
                float inputs:in.connect = </World/Materials/Fractal2dMat/Pattern.outputs:out>
                float inputs:inlow = -1.0
                float inputs:inhigh = 1.0
                float inputs:outlow = 0.0
                float inputs:outhigh = 1.0
                float outputs:out
            }

            def Shader "Colorize"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.07, 0.05, 0.10)
                color3f inputs:fg = (0.95, 0.53, 0.26)
                float inputs:mix.connect = </World/Materials/Fractal2dMat/Normalize.outputs:out>
                color3f outputs:out
            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color.connect = </World/Materials/Fractal2dMat/Colorize.outputs:out>
                float inputs:specular = 0.3
                float inputs:specular_roughness = 0.44
                token outputs:out
            }
        }

