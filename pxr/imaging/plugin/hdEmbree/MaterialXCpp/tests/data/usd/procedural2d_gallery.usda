                float2 inputs:uvoffset = (0.0, 0.0)
                float inputs:thickness = 0.12
                bool inputs:staggered = true
                float2 inputs:texcoord.connect = </World/Materials/CrosshatchMat/TexCoord.outputs:out>
                color3f outputs:out
            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color.connect = </World/Materials/CrosshatchMat/Pattern.outputs:out>
                float inputs:specular = 0.24
                float inputs:specular_roughness = 0.46
                token outputs:out
            }
        }

        def Material "LineMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/LineMat/StdSurf.outputs:out>

            def Shader "TexCoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "Pattern"
            {
                uniform token info:id = "ND_line_float"
                float2 inputs:texcoord.connect = </World/Materials/LineMat/TexCoord.outputs:out>
                float2 inputs:center = (0.0, 0.0)
                float inputs:radius = 0.05
                float2 inputs:point1 = (0.18, 0.78)
                float2 inputs:point2 = (0.82, 0.22)
                float outputs:out
            }

            def Shader "Colorize"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.06, 0.08, 0.12)
                color3f inputs:fg = (0.98, 0.88, 0.28)
                float inputs:mix.connect = </World/Materials/LineMat/Pattern.outputs:out>
                color3f outputs:out
            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color.connect = </World/Materials/LineMat/Colorize.outputs:out>
                float inputs:specular = 0.26
                float inputs:specular_roughness = 0.36
                token outputs:out
            }
        }

        def Material "Flake2dMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/Flake2dMat/StdSurf.outputs:out>

            def Shader "TexCoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "ScaleUV"
            {
                uniform token info:id = "ND_multiply_vector2FA"
                float2 inputs:in1.connect = </World/Materials/Flake2dMat/TexCoord.outputs:out>
                float inputs:in2 = 8.0
                float2 outputs:out
            }

            def Shader "Flake"
            {
                uniform token info:id = "ND_flake2d"
                float inputs:size = 0.18
                float inputs:roughness = 0.22
                float inputs:coverage = 0.72
                float2 inputs:texcoord.connect = </World/Materials/Flake2dMat/ScaleUV.outputs:out>
                int outputs:id
                float outputs:rand
                float outputs:presence
                float3 outputs:flakenormal
            }

            def Shader "Colorize"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.10, 0.12, 0.18)
                color3f inputs:fg = (0.88, 0.92, 1.0)
                float inputs:mix.connect = </World/Materials/Flake2dMat/Flake.outputs:presence>
                color3f outputs:out
            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color.connect = </World/Materials/Flake2dMat/Colorize.outputs:out>
                float inputs:specular = 0.75
                float inputs:specular_roughness = 0.12
                float3 inputs:normal.connect = </World/Materials/Flake2dMat/Flake.outputs:flakenormal>
                token outputs:out
            }
        }
    }

