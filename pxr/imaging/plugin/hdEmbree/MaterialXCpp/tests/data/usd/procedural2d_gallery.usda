        }

        def Material "RampMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/RampMat/StdSurf.outputs:out>

            def Shader "TexCoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "Pattern"
            {
                uniform token info:id = "ND_ramp"
                float2 inputs:texcoord.connect = </World/Materials/RampMat/TexCoord.outputs:out>
                int inputs:type = 3
                int inputs:interpolation = 1
                int inputs:num_intervals = 4
                float inputs:interval1 = 0.0
                color4f inputs:color1 = (0.07, 0.09, 0.18, 1.0)
                float inputs:interval2 = 0.35
                color4f inputs:color2 = (0.95, 0.48, 0.22, 1.0)
                float inputs:interval3 = 0.68
                color4f inputs:color3 = (0.98, 0.85, 0.32, 1.0)
                float inputs:interval4 = 1.0
                color4f inputs:color4 = (0.92, 0.95, 1.0, 1.0)
                color4f outputs:out
            }

            def Shader "ToColor3"
            {
                uniform token info:id = "ND_convert_color4_color3"
                color4f inputs:in.connect = </World/Materials/RampMat/Pattern.outputs:out>
                color3f outputs:out
            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color.connect = </World/Materials/RampMat/ToColor3.outputs:out>
                float inputs:specular = 0.28
                float inputs:specular_roughness = 0.32
                token outputs:out
            }
        }

        def Material "RampGradientMat"
