            {
                uniform token info:id = "ND_unifiednoise2d_float"
                float2 inputs:texcoord.connect = </World/Materials/Unifiednoise2dMat/TexCoord.outputs:out>
                float2 inputs:freq = (7.0, 4.0)
                float2 inputs:offset = (0.15, 0.35)
                float inputs:jitter = 0.75
                float inputs:outmin = 0.0
                float inputs:outmax = 1.0
                bool inputs:clampoutput = true
                int inputs:octaves = 4
                float inputs:lacunarity = 2.0
                float inputs:diminish = 0.5
                int inputs:type = 2
                int inputs:style = 1
                float outputs:out
            }

            def Shader "Colorize"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.10, 0.09, 0.14)
