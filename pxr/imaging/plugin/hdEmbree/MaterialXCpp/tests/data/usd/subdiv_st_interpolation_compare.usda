#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    doc = """Visual comparison scene for subdivision-surface st interpolation.
    Left:   primvars:st authored as vertex
    Center: primvars:st authored as varying
    Right:  primvars:st authored as faceVarying

    Row 1 uses Cube_Subdiv. Row 2 uses Sphere_Subdiv.
    A procedural emissive UV ramp makes interpolation differences easy to
    inspect.
    On a correct implementation:
    - vertex should follow subdivision vertex semantics
    - varying should follow subdivision varying (bilinear) semantics
    - faceVarying should preserve per-face UV seams
    """
)

def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 40
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 0.0, 9.5)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def "CubeVertexST" (
        prepend references = @./meshes/Cube_Subdiv.usda@</Root/Cube_Subdiv>
        prepend apiSchemas = ["MaterialBindingAPI"]
