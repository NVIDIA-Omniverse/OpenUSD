    def "SphereFaceVaryingST" (
        prepend references = @./meshes/Sphere_Subdiv.usda@</Root/Sphere_Subdiv>
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double3 xformOp:translate = (2.4, -1.8, 0)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.012, 0.012, 0.012)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        rel material:binding = </World/Materials/UvRamp>
    }

    def Scope "Materials"
    {
        def Material "UvRamp"
        {
            token outputs:mtlx:surface.connect = </World/Materials/UvRamp/StdSurf.outputs:out>

            def Shader "TexCoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "ExtractU"
            {
                uniform token info:id = "ND_extract_vector2"
                float2 inputs:in.connect = </World/Materials/UvRamp/TexCoord.outputs:out>
                int inputs:index = 0
                float outputs:out
            }

            def Shader "ExtractV"
            {
                uniform token info:id = "ND_extract_vector2"
                float2 inputs:in.connect = </World/Materials/UvRamp/TexCoord.outputs:out>
                int inputs:index = 1
                float outputs:out
            }

            def Shader "BottomLeft"
            {
                uniform token info:id = "ND_constant_color3"
                color3f inputs:value = (0.05, 0.10, 0.90)
                color3f outputs:out
            }

            def Shader "BottomRight"
            {
                uniform token info:id = "ND_constant_color3"
                color3f inputs:value = (0.95, 0.10, 0.10)
                color3f outputs:out
            }

            def Shader "TopLeft"
            {
                uniform token info:id = "ND_constant_color3"
                color3f inputs:value = (0.05, 0.90, 0.25)
                color3f outputs:out
            }

            def Shader "TopRight"
            {
                uniform token info:id = "ND_constant_color3"
                color3f inputs:value = (0.95, 0.95, 0.15)
                color3f outputs:out
            }

            def Shader "BottomMix"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </World/Materials/UvRamp/BottomLeft.outputs:out>
                color3f inputs:fg.connect = </World/Materials/UvRamp/BottomRight.outputs:out>
                float inputs:mix.connect = </World/Materials/UvRamp/ExtractU.outputs:out>
                color3f outputs:out
            }

            def Shader "TopMix"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </World/Materials/UvRamp/TopLeft.outputs:out>
                color3f inputs:fg.connect = </World/Materials/UvRamp/TopRight.outputs:out>
                float inputs:mix.connect = </World/Materials/UvRamp/ExtractU.outputs:out>
                color3f outputs:out
            }

            def Shader "UvColor"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </World/Materials/UvRamp/BottomMix.outputs:out>
                color3f inputs:fg.connect = </World/Materials/UvRamp/TopMix.outputs:out>
                float inputs:mix.connect = </World/Materials/UvRamp/ExtractV.outputs:out>
                color3f outputs:out
            }

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0.0
                float inputs:specular = 0.0
                float inputs:emission = 1.0
                color3f inputs:emission_color.connect = </World/Materials/UvRamp/UvColor.outputs:out>
                token outputs:out
            }
        }
    }
}
