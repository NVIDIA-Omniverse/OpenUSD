#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1.0
    renderSettingsPrimPath = "/RenderSettings"
    upAxis = "Y"
    doc = """Microfacet multiple-scattering smoke scene for hdEmbree.

All objects reference meshes/uni.usdc. Columns are roughness values:
0.05, 0.35, 0.65, 1.0.

Rows:
- white diffuse dielectric
- white specular-only dielectric with black base
- silver-like metallic
- gold-like metallic

The scene is intended for visual inspection of rough GGX energy recovery,
grazing-angle behavior, and roughness-ramp smoothness after Turquin-style
microfacet multiple-scattering compensation."""
)

def RenderSettings "RenderSettings"
{
    bool ty:enableGgxMicrofacetMultipleScattering = true
    int ty:lightSamplesPerHit = 1
    token ty:samplerSequence = "openqmc_sobolbn"
    rel products = [</RenderProduct>]
}

def RenderProduct "RenderProduct"
{
    rel orderedVars = [</RenderProduct/Color>]
    token productType = "raster"
    token productName = "microfacet_ms_smoke.exr"

    def RenderVar "Color"
    {
        token dataType = "color4f"
        string sourceName = "color"
        string sourceType = "raw"
    }
}

def Xform "World"
{
    def Camera "MainCamera"
    {
        float focalLength = 36
        float horizontalAperture = 36
        float verticalAperture = 24
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 2.8, 12.5)
        float3 xformOp:rotateXYZ = (-10, 0, 0)
        token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # def Mesh "GroundPlane" (
    #     prepend apiSchemas = ["MaterialBindingAPI"]
