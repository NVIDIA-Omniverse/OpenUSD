    def Xform "WhiteDiffuse_R005" (
        prepend references = @./meshes/uni.usdc@
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double3 xformOp:translate = (-4.5, 3.5, 0)
        float3 xformOp:scale = (0.58, 0.58, 0.58)
        token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Materials/WhiteDiffuseR005>
    }

