        def Material "GroundMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/GroundMat/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color = (0.18, 0.18, 0.18)
                float inputs:diffuse_roughness = 0.5
                float inputs:specular = 0.0
                token outputs:out
            }
        }

