#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    doc = """Multiple objects with different material models:
UsdPreviewSurface, Standard Surface, and OpenPBR."""
)

def Xform "World"
{
    def Sphere "SphereLeft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.8
        double3 xformOp:translate = (-2.5, 0, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/PreviewMat>
    }

    def Sphere "SphereCenter" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.8
        rel material:binding = </World/Materials/StdSurfMat>
    }

    def Sphere "SphereRight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.8
        double3 xformOp:translate = (2.5, 0, 0)
        token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/OpenPbrMat>
    }

    def Scope "Materials"
    {
        def Material "PreviewMat"
        {
            token outputs:surface.connect = </World/Materials/PreviewMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.2, 0.2)
                float inputs:roughness = 0.3
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }

        def Material "StdSurfMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/StdSurfMat/StdSurf.outputs:out>

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1.0
                color3f inputs:base_color = (0.2, 0.9, 0.2)
                float inputs:specular = 1.0
                float inputs:specular_roughness = 0.3
                float inputs:metalness = 0.0
                token outputs:out
            }
        }

        def Material "OpenPbrMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/OpenPbrMat/OpenPbr.outputs:out>

            def Shader "OpenPbr"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 1.0
                color3f inputs:base_color = (0.2, 0.2, 0.9)
                float inputs:specular_weight = 1.0
                float inputs:specular_roughness = 0.3
                float inputs:base_metalness = 0.0
                token outputs:out
            }
        }
    }

    def SphereLight "KeyLight"
    {
        float inputs:intensity = 600
        float inputs:radius = 1.0
        double3 xformOp:translate = (0, 5, 4)
        token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "FillLight"
    {
        float inputs:intensity = 200
        float inputs:radius = 2.0
        double3 xformOp:translate = (-4, 3, -2)
        token[] xformOpOrder = ["xformOp:translate"]
    }
}
