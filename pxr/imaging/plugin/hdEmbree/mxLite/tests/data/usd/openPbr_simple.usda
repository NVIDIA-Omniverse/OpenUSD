#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    doc = "MaterialX OpenPBR Surface material on a sphere."
)

def Xform "World"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        rel material:binding = </World/Materials/OpenPbrMat>
    }

    def Scope "Materials"
    {
        def Material "OpenPbrMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/OpenPbrMat/OpenPbr.outputs:out>

            def Shader "OpenPbr"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                float inputs:base_weight = 1.0
                color3f inputs:base_color = (0.2, 0.7, 0.3)
                float inputs:specular_weight = 1.0
                float inputs:specular_roughness = 0.3
                color3f inputs:specular_color = (1.0, 1.0, 1.0)
                float inputs:specular_ior = 1.5
                float inputs:base_metalness = 0.0
                token outputs:out
            }
        }
    }

    def SphereLight "Light"
    {
        float inputs:intensity = 500
        float inputs:radius = 0.5
        double3 xformOp:translate = (3, 4, 3)
        token[] xformOpOrder = ["xformOp:translate"]
    }
}
