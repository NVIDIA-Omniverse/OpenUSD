#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    doc = "Metallic UsdPreviewSurface — gold-like sphere."
)

def Xform "World"
{
    def Sphere "GoldSphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        rel material:binding = </World/Materials/GoldMat>
    }

    def Scope "Materials"
    {
        def Material "GoldMat"
        {
            token outputs:surface.connect = </World/Materials/GoldMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 0.78, 0.34)
                float inputs:roughness = 0.15
                float inputs:metallic = 1.0
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
    }

    def SphereLight "KeyLight"
    {
        float inputs:intensity = 400
        float inputs:radius = 1.0
        double3 xformOp:translate = (4, 5, 3)
        token[] xformOpOrder = ["xformOp:translate"]
    }
}
