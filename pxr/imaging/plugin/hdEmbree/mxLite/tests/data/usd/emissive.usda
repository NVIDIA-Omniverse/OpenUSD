#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    doc = "Standard Surface with emission — self-illuminated sphere."
)

def Xform "World"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        rel material:binding = </World/Materials/EmissiveMat>
    }

    def Scope "Materials"
    {
        def Material "EmissiveMat"
        {
            token outputs:mtlx:surface.connect = </World/Materials/EmissiveMat/StdSurf.outputs:out>

            def Shader "StdSurf"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 0.0
                color3f inputs:base_color = (0.0, 0.0, 0.0)
                float inputs:specular = 0.0
                float inputs:emission = 1.0
                color3f inputs:emission_color = (1.0, 0.6, 0.2)
                token outputs:out
            }
        }
    }
}
