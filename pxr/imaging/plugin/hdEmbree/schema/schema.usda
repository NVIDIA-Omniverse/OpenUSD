#usda 1.0
(
    "Typhoon render settings schema"
    subLayers = [
        @usdRender/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "hdEmbree"
        bool skipCodeGeneration = true
    }
)
{
}

class "TyphoonRenderSettingsAPI" (
    inherits = </APISchemaBase>
    doc = """Render settings for the Typhoon render delegate."""
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaAutoApplyTo = ["RenderSettings"]
        token[] apiSchemaCanOnlyApplyTo = ["RenderSettings"]
    }
)
{
    uniform int ty:convergedSamplesPerPixel = 256 (
        doc = """Samples per pixel before rendering is considered converged."""
    )

    uniform int ty:randomNumberSeed = -1 (
        doc = """OpenQMC frame seed. A value of -1 uses the current scene frame."""
    )

    uniform int ty:tileSize = 8 (
        doc = """Pixel width and height of each parallel rendering work item."""
    )

    uniform bool ty:dynamicSubdvTesselation = false (
        doc = """Recompute screen-space subdivision tessellation after camera or viewport changes."""
    )

    uniform float ty:minCurveWidth = 0.001 (
        doc = """Minimum BasisCurves diameter in prototype object space."""
    )

    uniform float ty:adaptiveThreshold = 0.01 (
        doc = """Variance threshold below which a pixel is considered converged."""
    )

    uniform int ty:minSamplesBeforeAdaptive = 64 (
        doc = """Minimum samples per pixel before adaptive convergence checks begin."""
    )

    uniform int ty:maxBounces = 16 (
        doc = """Maximum number of indirect light bounces."""
    )

    uniform int ty:minBouncesBeforeRR = 2 (
        doc = """Minimum number of bounces before Russian Roulette path termination."""
    )

    uniform int ty:lightSamplesPerHit = 1 (
        doc = """Number of light samples per hit point per light."""
    )

    uniform float ty:fireflyClampThreshold = 20.0 (
        doc = """Clamp threshold for bright non-caustic path contributions."""
    )

    uniform bool ty:enableCaustics = false (
        doc = """Enable indirect caustic paths."""
    )

    uniform float ty:causticsClampThreshold = 5.0 (
        doc = """Clamp threshold for caustic path contributions."""
    )

    uniform bool ty:disableShadows = false (
        doc = """Disable shadow visibility rays."""
    )

    uniform token ty:materialRenderContext = "mtlx" (
        allowedTokens = ["mtlx", "default"]
        doc = """Material render context priority."""
    )

    uniform bool ty:useAdobeOpenPBR = false (
        doc = """Use the Adobe OpenPBR BSDF for OpenPBR Surface."""
    )

    uniform token ty:dielectricLayerThroughputMode = "bsdl" (
        allowedTokens = ["bsdl", "materialxGlsl"]
        doc = """Rough dielectric top-layer throughput estimate mode."""
    )

    uniform int ty:textureCacheSize = 16384 (
        doc = """Size (in MB) of the OpenImageIO texture/tile cache."""
    )
}
