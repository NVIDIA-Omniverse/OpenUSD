#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1.0
    doc = "Simple UsdPreviewSurface material on a sphere."
)

def Xform "World"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1.0
        rel material:binding = </World/Materials/PreviewMat>
    }

    def Scope "Materials"
    {
        def Material "PreviewMat"
        {
            token outputs:surface.connect = </World/Materials/PreviewMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.2, 0.1)
                float inputs:roughness = 0.3
                float inputs:metallic = 0.0
                float inputs:ior = 1.5
                float inputs:opacity = 1.0
                token outputs:surface
            }
        }
    }

    def SphereLight "Light"
    {
        float inputs:intensity = 500
        float inputs:radius = 0.5
        double3 xformOp:translate = (3, 4, 3)
        token[] xformOpOrder = ["xformOp:translate"]
    }
}
