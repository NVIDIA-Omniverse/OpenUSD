            token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/Materials/ReceiverWhite>
        }

        def Sphere "TForceLS_Sphere" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double radius = 0.34
            double3 xformOp:translate = (7.5, 0.34, -2.75)
            token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/Materials/ReceiverWhite>
        }
    }

    def Scope "FixtureDisks"
    {
        def Cylinder "BR30_Fixture" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double radius = 0.26
            double height = 0.08
            double3 xformOp:translate = (-7.5, 4.45, -3.82)
            float3 xformOp:rotateXYZ = (90, 0, 0)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            rel material:binding = </World/Materials/FixtureMetal>
        }

        def Cylinder "Candle35_Fixture" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double radius = 0.22
            double height = 0.08
            double3 xformOp:translate = (-4.5, 4.45, -3.82)
