        )
        {
            double radius = 0.28
            double height = 0.08
            double3 xformOp:translate = (1.5, 4.45, -3.82)
            float3 xformOp:rotateXYZ = (90, 0, 0)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            rel material:binding = </World/Materials/FixtureMetal>
        }

        def Cylinder "TForceHB_Fixture" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double radius = 0.24
            double height = 0.08
            double3 xformOp:translate = (4.5, 4.45, -3.82)
            float3 xformOp:rotateXYZ = (90, 0, 0)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            rel material:binding = </World/Materials/FixtureMetal>
        }

        def Cylinder "TForceLS_Fixture" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double radius = 0.24
            double height = 0.08
            double3 xformOp:translate = (7.5, 4.45, -3.82)
            float3 xformOp:rotateXYZ = (90, 0, 0)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            rel material:binding = </World/Materials/FixtureMetal>
        }
    }

    def Scope "IESLights"
    {
        def DiskLight "BR30_2700K" (
            prepend apiSchemas = ["ShapingAPI"]
        )
        {
            float inputs:radius = 0.18
            float inputs:intensity = 5
            bool inputs:normalize = true
            bool inputs:enableColorTemperature = true
            float inputs:colorTemperature = 2700
            float inputs:shaping:cone:angle = 80
            float inputs:shaping:cone:softness = 0.35
            asset inputs:shaping:ies:file = @../ies/LEDBulbs_BR30_120V_19-120W_1200lm_2700K_E26_D-IES.ies@
            float inputs:shaping:ies:angleScale = 1
            bool inputs:shaping:ies:normalize = true
            double3 xformOp:translate = (-7.5, 4.28, -3.38)
            float3 xformOp:rotateXYZ = (-90, 0, 0)
            token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def DiskLight "Candle_3p5W_Warm" (
            prepend apiSchemas = ["ShapingAPI"]
        )
        {
            float inputs:radius = 0.16
            float inputs:intensity = 5
            bool inputs:normalize = true
            bool inputs:enableColorTemperature = true
            float inputs:colorTemperature = 2400
            float inputs:shaping:cone:angle = 92
            float inputs:shaping:cone:softness = 0.45
            asset inputs:shaping:ies:file = @../ies/LEDcandle_CLAF_3,5W_BA11_E26_922_927_CL-IES.IES@
            float inputs:shaping:ies:angleScale = 1
            bool inputs:shaping:ies:normalize = true
